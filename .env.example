DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"
JWT_SECRET="reemplazar-con-secreto-aleatorio-de-32-caracteres-minimo"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432

# G2-24: Zona horaria institucional para normalizar fechas del libro de horas
INSTITUTION_TIMEZONE="America/Guayaquil"
