DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"

# Secreto para firmar los JWT. Es requerido para arrancar la aplicación.
# Para entorno local puedes usar cualquier cadena. Para producción, genera
# una cadena segura (ej. con openssl rand -base64 32)
JWT_SECRET="cambiame-en-produccion"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432
